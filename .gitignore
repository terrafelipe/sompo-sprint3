# Rede de segurança do monorepo (reforço aos .gitignore de cada subprojeto).
# NUNCA versionar segredos:
**/.env
**/.env.*
!**/.env.example
**/segredos.h

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# Build do firmware (Arduino IDE)
**/build/
**/*.bin
**/*.elf

# Artefatos gerados
**/plano_b/

# Editores
.vscode/
.idea/

# Lixo do sistema operacional
**/.DS_Store
**/Thumbs.db
**/desktop.ini
