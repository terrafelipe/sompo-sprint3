# Rede de segurança do monorepo (reforço aos .gitignore de cada subprojeto).
# NUNCA versionar segredos:
**/.env
**/.env.*
!**/.env.example
**/segredos.h

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# Build do firmware (Arduino IDE)
**/build/
**/*.bin
**/*.elf

# Editores
.vscode/
.idea/
# Excecao: a config da extensao Arduino E entregavel - e o que faz o VS Code
# saber a placa (esp32dev), achar o arduino-cli portatil e montar o IntelliSense.
!firmware/sompo_hardware_final/.vscode/
!firmware/sompo_hardware_final/.vscode/*.json

# Lixo do sistema operacional
**/.DS_Store
**/Thumbs.db
**/desktop.ini
