# Rede de segurança do monorepo (reforço aos .gitignore de cada subprojeto).
# NUNCA versionar segredos:
**/.env
**/.env.*
!**/.env.example
**/segredos.h

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# PlatformIO / build do firmware
**/.pio/
**/compile_commands.json

# Artefatos gerados
**/plano_b/

# Editores
.vscode/
.idea/

# Lixo do sistema operacional
**/.DS_Store
**/Thumbs.db
**/desktop.ini
