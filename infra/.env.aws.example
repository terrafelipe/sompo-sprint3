# Copie para infra/.env.aws (gitignorado) e preencha. O deploy-aws.ps1 envia estas
# variaveis para a Lambda. NUNCA versionar o .env.aws.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Liga o login; valor aleatorio, NAO e senha de ninguem (logins na tabela usuario).
PAINEL_SENHA=
# Fixa! Senao cada cold start gera outra e todo mundo e deslogado.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSAO_HORAS=24
# Manter VAZIA: o painel usa a sessao de login (ver docs/DEPLOY.md).
SOMPO_API_KEY=
