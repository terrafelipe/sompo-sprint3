# Copie para .env NA RAIZ do repo (nao confundir com api/.env, que guarda as
# chaves do Supabase/Gemini). Este aqui so parametriza o deploy.
#
#     cp .env.deploy.example .env
#
# O .env da raiz ja esta no .gitignore.

# Dominio que aponta para o IP da instancia. O Let's Encrypt NAO emite
# certificado para IP puro - sem dominio nao ha HTTPS.
# Opcao de custo zero: DuckDNS (ex.: sompo-fiap.duckdns.org).
DOMINIO=seu-nome.duckdns.org

# E-mail de contato do Let's Encrypt (avisos de expiracao). Nao vai para o site.
EMAIL_CERTBOT=voce@exemplo.com
