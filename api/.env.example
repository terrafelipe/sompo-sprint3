SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=

# IA (Google Gemini). Chave gratuita em https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Seguranca (ver docs/SEGURANCA.md)
# Vazio = auth desligada (demo). Definido = toda rota (menos /saude) exige o
# header 'X-API-Key' com este valor.
SOMPO_API_KEY=
# Origens liberadas para CORS, separadas por virgula. Vazio = nenhuma.
CORS_ORIGINS=

# Login do painel publico (pagina /login + sessao) - ver docs/DEPLOY.md.
# PAINEL_SENHA vazia = login desligado (demo local aberta). Definida = TODO o
# site (painel + endpoints) exige login. Use HTTPS (o Render ja fornece).
PAINEL_USUARIO=sompo
PAINEL_SENHA=
# Assina o cookie de sessao do login. Vazia = aleatoria a cada start (desloga ao
# reiniciar). Em producao defina um valor fixo e aleatorio (ex.: 64 chars hex).
SECRET_KEY=
# Tempo maximo (horas) de uma sessao antes de exigir novo login. Padrao 24.
SESSAO_HORAS=24
